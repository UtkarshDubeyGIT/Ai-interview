# Application
APP_BASE_URL=https://interview.example.com
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://interview:replace-me@db:5432/interview

# AI — server-side only
VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime

# Seeded demo account
SEED_ADMIN_EMAIL=demo@example.com
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Docker database initialization
POSTGRES_DB=interview
POSTGRES_USER=interview
POSTGRES_PASSWORD=replace-me

# Caddy
DOMAIN=interview.example.com
